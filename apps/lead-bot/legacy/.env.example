# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# LLM API Key (OpenAI / DeepSeek / другой OpenAI-compatible провайдер)
OPENAI_API_KEY=your-llm-api-key
# Для DeepSeek (OpenAI-compatible API), например: https://api.deepseek.com/v1
OPENAI_BASE_URL=

# Admin Telegram ID (ваш ID, получить у @userinfobot)
ADMIN_TELEGRAM_ID=123456789
# Дополнительные доверенные operator-аккаунты для business handoff через запятую
BUSINESS_OPERATOR_TELEGRAM_IDS=

# Leads Chat ID (опционально - ID чата/канала для уведомлений о лидах)
# Если не указан, уведомления отправляются напрямую админу
# Для получения ID: добавьте бота в группу/канал, отправьте сообщение и используйте @userinfobot
LEADS_CHAT_ID=
ALLOW_ADMIN_TEST_LEADS=1
CORE_API_URL=http://localhost:8000
API_KEY_BOT=
CONTRACT_AI_SYSTEM_URL=https://contract.ai-verdict.ru
API_KEY_NEWS=
API_KEY_ADMIN=
CORE_API_SYNC_ENABLED=1
CORE_API_TIMEOUT_SECONDS=5
CORE_API_CACHE_TTL_SECONDS=15
CORE_API_STALE_CACHE_TTL_SECONDS=120
CORE_API_POST_DEDUP_TTL_SECONDS=20
TELEGRAM_FORCE_IPV4=1
# Список реально готовых модулей через запятую (ключи каталога):
# consultation_30m, process_audit, lead_intake_pilot, contract_review_assist,
# litigation_assist, compliance_monitoring, legal_ops_outsource, custom_integrations
AVAILABLE_SERVICE_MODULES=consultation_30m,process_audit

# Compliance URLs (документы)
PRIVACY_POLICY_URL=https://ai-verdict.ru/privacy
TRANSBORDER_CONSENT_URL=https://ai-verdict.ru/transborder-consent
USER_AGREEMENT_URL=https://ai-verdict.ru/user-agreement
AI_POLICY_URL=https://ai-verdict.ru/ai-policy
MARKETING_CONSENT_URL=https://ai-verdict.ru/marketing-consent
PRIVACY_CONTACT_EMAIL=privacy@ai-verdict.ru
OPERATOR_NAME=AI Verdict
OPERATOR_INN=
OPERATOR_DETAILS=
CONVERSATION_RETENTION_DAYS=90
CONVERSATION_CLEANUP_INTERVAL_HOURS=24

# OpenAI Settings (можно использовать AI_MODEL или OPENAI_MODEL)
AI_MODEL=gpt-4o-mini
MAX_TOKENS=800
MAX_COMPLETION_TOKENS=16000  # Лимит токенов только на ответ (не включает prompt)
TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
STREAMING_PREVIEW=0

# Database
DB_PATH=data/bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Bot Behavior
MAX_HISTORY_MESSAGES=15
RESPONSE_DELAY=1

# Security / anti-abuse
SECURITY_HUMAN_ONLY_ENABLED=1
SECURITY_CALLBACKS_PER_MINUTE=12
SECURITY_CALLBACK_DUPLICATE_WINDOW_SECONDS=8
SECURITY_CALLBACK_DUPLICATE_BURST=2
SECURITY_NON_TEXT_PER_HOUR=10
SECURITY_ALLOWED_DOCUMENT_MIME_PREFIXES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/,image/
SECURITY_ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt,rtf,png,jpg,jpeg
SECURITY_DOCUMENT_MAX_BYTES=15728640
SECURITY_PHOTO_MAX_BYTES=10485760
SECURITY_QUARANTINE_MINUTES=60
SECURITY_QUARANTINE_STRIKES=3
SECURITY_BLACKLIST_STRIKES=6
SECURITY_ALERT_BURST_THRESHOLD=5

# Email Settings (SMTP) - для отправки lead magnets
# Для Gmail нужно создать App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Андрей Попов - AI Verdict
