# ==========================================
# ANALYTICS TRACKING (для сбора статистики на сайте)
# ==========================================

# ==========================================
# CORE API (новое ядро backend)
# ==========================================

# URL core-api для server-side route handlers (например, /api/admin/automation-controls)
# Локально: http://127.0.0.1:8000
CORE_API_URL=http://127.0.0.1:8000

# Публичный URL core-api (если нужно в клиентских запросах)
NEXT_PUBLIC_CORE_API_URL=http://127.0.0.1:8000

# Админ-ключ core-api для server-side proxy routes
# Можно использовать CORE_API_ADMIN_KEY или API_KEY_ADMIN
CORE_API_ADMIN_KEY=
API_KEY_ADMIN=

# Ключ scope=bot для отправки лидов из формы сайта в POST /api/v1/leads
# Если не задан, будет fallback на admin-ключ
CORE_API_BOT_KEY=
API_KEY_BOT=

# Google Analytics 4 - Measurement ID для счетчика на сайте
# Получите на: https://analytics.google.com/ → Admin → Data Streams
# Формат: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Yandex Metrika - Counter ID для счетчика на сайте
# Получите на: https://metrika.yandex.ru/
# Формат: 12345678 (8 цифр)
# NEXT_PUBLIC_YM_COUNTER_ID=12345678

# ==========================================
# ADMIN PANEL CONFIGURATION
# ==========================================

# bcrypt-хэш пароля для доступа к админ-панели
# Plain-text пароль больше не рекомендуется хранить в env.
ADMIN_PANEL_PASSWORD_HASH=

# Base32 TOTP secret для второго фактора
ADMIN_PANEL_TOTP_SECRET=

# Отдельный секрет подписи admin-сессии (рекомендуется, не равен паролю)
# Обязателен для входа в админ-панель.
ADMIN_PANEL_SESSION_SECRET=

# TTL admin-сессии в секундах (по умолчанию 8 часов)
ADMIN_PANEL_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_MAX_CONCURRENT=2
ADMIN_SESSION_TOUCH_INTERVAL_SECONDS=60
ADMIN_PANEL_TOTP_WINDOW_STEPS=1
ADMIN_SECURITY_STORE_PATH=.data/web-admin-security.json

# Ограничение попыток входа в админ-панель (brute-force guard)
ADMIN_AUTH_MAX_ATTEMPTS=10
ADMIN_AUTH_WINDOW_SECONDS=900
ADMIN_AUTH_BLOCK_SECONDS=900

# ==========================================
# MINI-APP TELEGRAM AUTH (server-side verify)
# ==========================================

# Токен reader-бота для верификации Telegram WebApp initData.
# Если не задан, будет fallback на TELEGRAM_BOT_TOKEN.
READER_BOT_TOKEN=

# Требовать валидный X-Telegram-Init-Data в mini-app API (рекомендуется 1)
MINIAPP_REQUIRE_TELEGRAM_AUTH=1

# Отключить только для локальной отладки вне Telegram (0/1)
MINIAPP_ALLOW_UNVERIFIED=0

# Максимальный age initData (сек), по умолчанию 3600
MINIAPP_TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

# GitHub Token (опционально, только для приватных репозиториев)
# Получите на: https://github.com/settings/tokens
# Scope: repo (для приватных репозиториев)
# Для публичных репозиториев токен не нужен
# GITHUB_TOKEN=ghp_your_token_here

# Google Analytics 4 (опционально, для аналитики в админ-панели)
# Property ID из Google Analytics 4
# GA4_PROPERTY_ID=123456789
#
# Service Account credentials в формате JSON (для GA4 Data API)
# Получите на: https://console.cloud.google.com/iam-admin/serviceaccounts
# Нужные разрешения: Analytics Viewer
# GA4_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs"}

# Yandex Metrika (опционально, для аналитики в админ-панели)
# Counter ID из Яндекс.Метрики
# YM_COUNTER_ID=12345678
#
# OAuth токен для доступа к API Metrika
# Получите на: https://oauth.yandex.ru/authorize?response_type=token&client_id=c2e6111dbaff4ae883c43a9bf8ac9231
# Нужные разрешения: metrika:read
# YM_ACCESS_TOKEN=y0_AgAAAAA...

# Site URL (для production указать реальный URL)
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Канонический пользовательский entrypoint во внешний Contract_AI_System.
# Если не задан, action-кнопки fallback'ятся на внутреннюю страницу /contract-ai-system.
NEXT_PUBLIC_CONTRACT_AI_SYSTEM_URL=

# ==========================================
# PUBLIC LEGAL / DISCLOSURE PROFILE
# ==========================================

# Эти значения публично показываются в legal pages, footer и schema.org.
NEXT_PUBLIC_OPERATOR_NAME=Legal AI PRO
NEXT_PUBLIC_OPERATOR_STATUS=самозанятый
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_DETAILS=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@legalaipro.ru
NEXT_PUBLIC_CONTACT_PHONE=+7 900 000-00-00
NEXT_PUBLIC_CONTACT_TELEGRAM=@legal_ai_helper_new_bot
NEXT_PUBLIC_LEAD_BOT_USERNAME=legal_ai_helper_new_bot
NEXT_PUBLIC_READER_BOT_USERNAME=legal_ai_news_reader_bot
NEXT_PUBLIC_CHANNEL_USERNAME=legal_ai_pro
