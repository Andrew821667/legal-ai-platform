<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ru.legalai.happ-plus.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/andrej/bin/happ-plus-watchdog.sh</string>
  </array>
  <!-- Monitor every 60 seconds. Automatic connection remains disabled unless
       HAPP_AUTO_START=1 is explicitly supplied in EnvironmentVariables. -->
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/andrej/Library/Logs/happ-plus-watchdog.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/andrej/Library/Logs/happ-plus-watchdog.stderr.log</string>
</dict>
</plist>
