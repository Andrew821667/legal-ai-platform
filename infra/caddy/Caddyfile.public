{
    email {$ACME_EMAIL}
}

:8088 {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    handle /api/v1/* {
        reverse_proxy core-api:8000
    }

    handle /health {
        reverse_proxy core-api:8000
    }

    handle /health/detailed {
        reverse_proxy core-api:8000
    }

    handle /guacamole* {
        reverse_proxy {$GUACAMOLE_UPSTREAM:host.docker.internal:8080}
    }

    handle /telegram-mcp* {
        uri strip_prefix /telegram-mcp
        reverse_proxy host.docker.internal:8791
    }

    handle /lawtable {
        redir /lawtable/app 302
    }

    handle_path /lawtable/* {
        reverse_proxy host.docker.internal:3001
    }

    handle {
        reverse_proxy web:3000
    }
}

http://www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} 308
}

http://{$DOMAIN}, http://{$CONTRACT_DOMAIN}, http://{$MONITOR_DOMAIN:monitor.ai-verdict.ru}, http://{$MEMORY_DOMAIN:memory.ai-verdict.ru} {
    redir https://{host}{uri} 308
}

https://www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} 308
}

https://{$CONTRACT_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    reverse_proxy {$CONTRACT_AI_UPSTREAM}
}

https://{$DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    handle /api/v1/* {
        reverse_proxy core-api:8000
    }

    handle /health {
        reverse_proxy core-api:8000
    }

    handle /health/detailed {
        reverse_proxy core-api:8000
    }

    # Guacamole намеренно не публикуется на основном домене:
    # единственная публичная точка входа — {$MEMORY_DOMAIN}, и она закрыта basic_auth.

    handle /telegram-mcp* {
        uri strip_prefix /telegram-mcp
        reverse_proxy host.docker.internal:8791
    }

    handle /lawtable {
        redir /lawtable/app 302
    }

    handle_path /lawtable/* {
        reverse_proxy host.docker.internal:3001
    }

    handle {
        reverse_proxy web:3000
    }
}

https://{$MEMORY_DOMAIN:memory.ai-verdict.ru} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    handle /robots.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond `User-agent: *
Disallow: /
` 200
    }

    handle /sitemap.xml {
        respond 404
    }

    # Guacamole — шлюз удалённого доступа к хосту. Закрыт basic_auth, чтобы
    # форма входа не отдавалась в интернет: без пароля отдаётся только 401,
    # поэтому перебор учётных данных и эксплуатация уязвимостей самого
    # Guacamole недоступны неаутентифицированному клиенту.
    handle /guacamole* {
        basic_auth {
            {$GUAC_BASIC_AUTH_USER:av} {$GUAC_BASIC_AUTH_HASH}
        }
        reverse_proxy {$GUACAMOLE_UPSTREAM:host.docker.internal:8080}
    }

    handle /telegram-mcp* {
        uri strip_prefix /telegram-mcp
        reverse_proxy host.docker.internal:8791
    }

    handle {
        reverse_proxy {$MEMORY_HUB_UPSTREAM:host.docker.internal:8787} {
            lb_try_duration 30s
            lb_try_interval 1s
        }
    }
}

https://{$MONITOR_DOMAIN:monitor.ai-verdict.ru} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    handle /robots.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond `User-agent: *
Disallow: /
` 200
    }

    handle /sitemap.xml {
        respond 404
    }

    handle /api/* {
        reverse_proxy web:3000
    }

    handle /_next/* {
        reverse_proxy web:3000
    }

    handle /icon.svg {
        reverse_proxy web:3000
    }

    handle /favicon.ico {
        reverse_proxy web:3000
    }

    handle /monitor* {
        reverse_proxy web:3000
    }

    handle {
        rewrite * /monitor
        reverse_proxy web:3000
    }
}
