{
    email {$ACME_EMAIL}
}

:8088 {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Ядро наружу — только то, что ходит снаружи: воркер договоров (MacBook)
    # и мост Contract AI. Сайт, боты и новости обращаются к core-api:8000
    # внутри сети; ключ бота видит данные клиентов, и публиковать весь
    # /api/v1 в интернет незачем (аудит периметра, 27.09).
    @core_public path /api/v1/workers /api/v1/workers/* /api/v1/contract-jobs /api/v1/contract-jobs/* /api/v1/contract-ai/*
    handle @core_public {
        reverse_proxy core-api:8000
    }

    handle /api/v1/* {
        respond 404
    }

    handle /health {
        reverse_proxy core-api:8000
    }

    handle /health/detailed {
        reverse_proxy core-api:8000
    }

    handle /lawtable {
        redir /lawtable/app 302
    }

    handle_path /lawtable/* {
        reverse_proxy host.docker.internal:3001
    }

    handle {
        reverse_proxy web:3000
    }
}

http://www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} 308
}

http://{$DOMAIN}, http://{$CONTRACT_DOMAIN}, http://{$MONITOR_DOMAIN:monitor.ai-verdict.ru}, http://{$MEMORY_DOMAIN:memory.ai-verdict.ru} {
    redir https://{host}{uri} 308
}

https://www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} 308
}

https://{$CONTRACT_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    reverse_proxy {$CONTRACT_AI_UPSTREAM}
}

https://{$DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Ядро наружу — только то, что ходит снаружи: воркер договоров (MacBook)
    # и мост Contract AI. Сайт, боты и новости обращаются к core-api:8000
    # внутри сети; ключ бота видит данные клиентов, и публиковать весь
    # /api/v1 в интернет незачем (аудит периметра, 27.09).
    @core_public path /api/v1/workers /api/v1/workers/* /api/v1/contract-jobs /api/v1/contract-jobs/* /api/v1/contract-ai/*
    handle @core_public {
        reverse_proxy core-api:8000
    }

    handle /api/v1/* {
        respond 404
    }

    handle /health {
        reverse_proxy core-api:8000
    }

    handle /health/detailed {
        reverse_proxy core-api:8000
    }

    handle /lawtable {
        redir /lawtable/app 302
    }

    handle_path /lawtable/* {
        reverse_proxy host.docker.internal:3001
    }

    handle {
        reverse_proxy web:3000 {
            # Затираем присланный клиентом X-Forwarded-For: до приложения
            # должен доходить только реальный адрес соединения. Иначе клиент
            # подставляет произвольное значение, получает новый ключ
            # троттлинга на каждом запросе и обходит лимит попыток входа
            # в админку (/api/admin/auth).
            header_up X-Forwarded-For {remote_host}
        }
    }
}

https://{$MEMORY_DOMAIN:memory.ai-verdict.ru} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    handle /robots.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond `User-agent: *
Disallow: /
` 200
    }

    handle /sitemap.xml {
        respond 404
    }

    # Guacamole (удалённый рабочий стол хоста) и /telegram-mcp удалены
    # 01.10.2026 по решению владельца. Memory-hub остаётся: его коннекторы
    # (Claude, ChatGPT) ходят в /mcp с OAuth, остальные маршруты hub закрыты
    # его собственной авторизацией. Описание API наружу не отдаём.
    @memory_api_docs path /docs /docs/* /redoc /redoc/* /openapi.json
    handle @memory_api_docs {
        respond 404
    }

    handle {
        reverse_proxy {$MEMORY_HUB_UPSTREAM:host.docker.internal:8787} {
            lb_try_duration 30s
            lb_try_interval 1s
        }
    }
}

https://{$MONITOR_DOMAIN:monitor.ai-verdict.ru} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    handle /robots.txt {
        header Content-Type "text/plain; charset=utf-8"
        respond `User-agent: *
Disallow: /
` 200
    }

    handle /sitemap.xml {
        respond 404
    }

    handle /api/* {
        reverse_proxy web:3000 {
            # См. комментарий на основном домене: /api/admin/* доступен и здесь,
            # поэтому клиентский X-Forwarded-For затирается так же.
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle /_next/* {
        reverse_proxy web:3000
    }

    handle /icon.svg {
        reverse_proxy web:3000
    }

    handle /favicon.ico {
        reverse_proxy web:3000
    }

    handle /monitor* {
        reverse_proxy web:3000
    }

    handle {
        rewrite * /monitor
        reverse_proxy web:3000
    }
}
