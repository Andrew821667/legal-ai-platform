{$CONTRACT_DOMAIN} {
    encode zstd gzip
    reverse_proxy {$CONTRACT_AI_UPSTREAM}
}

{$DOMAIN} {
    encode zstd gzip

    handle /api/v1/* {
        reverse_proxy core-api:8000
    }

    handle /health {
        reverse_proxy core-api:8000
    }

    handle /health/detailed {
        reverse_proxy core-api:8000
    }

    handle {
        reverse_proxy web:3000
    }
}
