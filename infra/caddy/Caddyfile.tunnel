:8088 {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @contract host {$CONTRACT_DOMAIN:contract.ai-verdict.ru}
    handle @contract {
        reverse_proxy {$CONTRACT_AI_UPSTREAM:host.docker.internal:3000}
    }

    handle /api/v1/* {
        reverse_proxy core-api:8000
    }

    handle /health {
        reverse_proxy core-api:8000
    }

    handle /health/detailed {
        reverse_proxy core-api:8000
    }

    handle {
        reverse_proxy web:3000
    }
}
